{
  "name": "workloom-pmtest",
  "productName": "WorkLoom PMtest",
  "workloomPortOffset": 231,
  "workloomStartPath": "/development",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@workloom/base": "workspace:*",
    "@workloom/runtime": "workspace:*",
    "@workloom/shared": "workspace:*",
    "pg": "8.23.0",
    "yaml": "2.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev-note.js && concurrently -k -n server,web \"pnpm -C apps/server dev\" \"pnpm -C apps/web dev\"",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "BUNDLE_DIR=bundles/hotel tsx --env-file=.env scripts/seed.ts",
    "demo": "TOOL_UNVERIFIED_RATE=0 tsx --env-file=.env scripts/demo.ts",
    "doctor": "bash scripts/doctor.sh",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:governance && pnpm test:reset-safety && pnpm test:payload-boundary && pnpm test:deploy-linux && pnpm test:release-assets && pnpm test:action-trust && pnpm test:release-policy && pnpm test:desktop-bootstrap && pnpm test:desktop-source && pnpm test:pm-deepseek-218 && pnpm test:pm-evaluation-state && pnpm pm:budget:test && pnpm test:assistant-218 && pnpm -r --if-present test && pnpm test:oss",
    "test:reset-safety": "node --test scripts/reset-safety.test.mjs",
    "test:payload-boundary": "node --test scripts/product-runtime.test.mjs scripts/verify-repo-owned-client.test.mjs scripts/payload-policy.test.mjs scripts/pack-nm-merge.test.mjs scripts/runtime-deps-lock.test.mjs scripts/prune-workspace-deps.test.mjs",
    "test:deploy-linux": "node --test scripts/deploy-linux.test.mjs",
    "runtime:deps:refresh": "node scripts/runtime-deps-lock.mjs refresh",
    "runtime:deps:verify": "node scripts/runtime-deps-lock.mjs verify",
    "pm:eval": "tsx --env-file=.env apps/server/src/industry/ai-pm/acceptance/evaluate.mts",
    "pm:budget:test": "node --test scripts/pm-budget-proxy.test.mjs scripts/pm-task-budget.test.mjs",
    "pm:deepseek:218": "tsx scripts/pm-deepseek-218.mjs",
    "pm:deepseek:218:catalog": "node scripts/pm-deepseek-218-catalog.mjs --check",
    "pm:deepseek:218:catalog:write": "node scripts/pm-deepseek-218-catalog.mjs --write",
    "test:pm-deepseek-218": "node --test scripts/pm-deepseek-218.test.mjs",
    "assistant:218": "node --import tsx scripts/assistant-218.mjs",
    "assistant:task-acceptance": "node --import tsx scripts/assistant-task-acceptance.mjs",
    "test:assistant-218": "node --import tsx --test scripts/assistant-218.test.mjs",
    "test:pm-dsh": "node --import tsx --test apps/server/src/industry/ai-pm/acceptance/dsh-integration.mts",
    "test:pm-evaluation-state": "node --test apps/server/src/industry/ai-pm/acceptance/metrics.node-test.mjs apps/server/src/industry/ai-pm/acceptance/state.node-test.mjs",
    "test:release-assets": "node --test scripts/release-assets.test.mjs",
    "test:action-trust": "node --test scripts/action-trust-policy.test.mjs",
    "test:release-policy": "node --test scripts/release-publisher-policy.test.mjs scripts/desktop-release-policy.test.mjs scripts/desktop-release-state.test.mjs scripts/desktop-workflow-path.test.mjs scripts/desktop-release-finalizer.test.mjs",
    "test:desktop-bootstrap": "node --test apps/desktop/electron/bootstrap.test.cjs scripts/desktop-bootstrap-db.test.mjs",
    "db:verify-chain": "tsx --env-file=.env scripts/verify-chain.ts",
    "suite": "TOOL_UNVERIFIED_RATE=0 tsx --env-file=.env scripts/suite.ts",
    "release:gate": "tsx --env-file=.env scripts/release-gate.ts",
    "agent:tour": "bash scripts/agent-tour.sh",
    "preview:all": "bash scripts/preview-all.sh",
    "check:builds": "node scripts/check-derived-builds.mjs",
    "capabilities": "node scripts/generate-capabilities.mjs",
    "capabilities:check": "node scripts/generate-capabilities.mjs --check",
    "product:verify": "node scripts/verify-product-content.mjs",
    "bundle:governance": "tsx scripts/bundle-governance.mts",
    "bundle:governance:test": "vitest run scripts/bundle-governance.test.ts",
    "bundle:seal": "tsx scripts/bundle-governance.mts --refresh-digests",
    "bundle:release": "tsx scripts/bundle-governance.mts --refresh-digests --release",
    "projections:generate": "tsx scripts/generate-client-projections.mts --write",
    "projections:check": "tsx scripts/generate-client-projections.mts",
    "ui:governance": "node --test scripts/ui-governance-rules.test.mjs scripts/check-webc-shell-contract.test.mjs && node scripts/verify-ui-governance.mjs",
    "ui:governance:test": "node --test scripts/ui-governance-rules.test.mjs",
    "ui:e2e": "node --test scripts/ui-e2e-preview.test.mjs && playwright test",
    "ui:e2e:update": "playwright test --update-snapshots",
    "pc-shell:verify": "node scripts/verify-pc-shell.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs --files AGENTS.md AGENTS.repo.md WORKLOOM_PRODUCT_CONTEXT.md",
    "secrets:scan:staged": "node scripts/secret-scan.mjs --staged",
    "capabilities:pptx": "python3 scripts/build-capability-pptx.py",
    "postinstall": "pnpm -C packages/ui build && pnpm -C packages/industry-contract build && (node scripts/postinstall-note.js || true)",
    "oss:watch": "bash scripts/oss-watch.sh",
    "oss:plan": "bash scripts/oss-watch.sh --show",
    "db:seed:boost": "tsx --env-file=.env scripts/seed-boost.ts",
    "computer": "tsx packages/base/computer-use/cli.ts",
    "computer:preflight": "bash packages/base/computer-use/toolkit/preflight_check.sh",
    "computer:start": "bash packages/base/computer-use/toolkit/start_desktop.sh",
    "computer:stop": "bash packages/base/computer-use/toolkit/stop_desktop.sh",
    "computer:serve": "tsx packages/base/computer-use/serve.ts",
    "computer:mcp": "tsx packages/base/computer-use/mcp.ts",
    "computer:smoke": "tsx packages/base/computer-use/smoke.ts",
    "setup": "bash scripts/bootstrap.sh",
    "setup:full": "bash scripts/bootstrap.sh --with-computer",
    "skill:forge": "tsx scripts/skill-forge.mts",
    "app": "tsx scripts/desktop-app.mts",
    "app:dev": "tsx scripts/desktop-app.mts --dev",
    "app:pack": "electron-builder --dir",
    "app:dist": "electron-builder",
    "setup:lite": "tsx scripts/setup-lite.mts",
    "db:seed:aipm": "tsx --env-file=.env scripts/seed-aipm.ts",
    "db:seed:aipm:verify-idempotence": "tsx --env-file=.env scripts/verify-seed-aipm-idempotence.ts",
    "oss:inventory": "bash scripts/oss-watch.sh --inventory",
    "oss:check": "bash scripts/oss-watch.sh --check",
    "test:oss": "node --test scripts/oss-inventory.test.mjs",
    "acceptance:profile:check": "node scripts/acceptance/profile-check.mjs",
    "acceptance:matrix": "tsx --env-file=.env scripts/acceptance/matrix.mts",
    "acceptance:ui": "node scripts/acceptance/ui-probe.mjs",
    "acceptance:experience": "node scripts/acceptance/experience.mjs",
    "acceptance:ux": "node scripts/acceptance/ux.mjs",
    "acceptance:outcome": "node scripts/acceptance/outcome.mjs",
    "acceptance:live": "node scripts/acceptance/live.mjs",
    "acceptance:live:selftest": "node scripts/acceptance/live.mjs --selftest",
    "acceptance:autonomy": "node scripts/acceptance/autonomy.mjs",
    "acceptance:redteam": "node scripts/acceptance/redteam.mjs",
    "acceptance:soak": "node scripts/acceptance/soak.mjs",
    "acceptance:coverage": "node scripts/acceptance/coverage.mjs",
    "acceptance:report": "node scripts/acceptance/report-v3.mjs",
    "acceptance:report:v2": "node scripts/acceptance/report.mjs",
    "test:governance": "node --test scripts/delivery/*.test.mjs scripts/acceptance/fleet-run.test.mjs scripts/acceptance/lib/environment-safety.test.mjs scripts/acceptance/lib/outcome-contract.test.mjs scripts/acceptance/lib/live/budget.test.mjs scripts/acceptance/lib/live/live-truth.test.mjs scripts/acceptance/lib/live/providers.test.mjs scripts/acceptance/lib/live/usage.test.mjs scripts/acceptance/lib/live/audit.test.mjs scripts/acceptance/lib/live/providers-http.test.mjs scripts/capability-status.test.mjs scripts/oss-inventory.test.mjs scripts/oss-watch.test.mjs scripts/tools/provision-safety.test.mjs sync/direct-push.test.mjs scripts/acceptance/lib/live/product.test.mjs scripts/acceptance/lib/live/media-negative.test.mjs scripts/acceptance/lib/live/live-cli.test.mjs scripts/acceptance/outcome.test.mjs scripts/acceptance/lib/profile-contract.test.mjs scripts/acceptance/profile-check.test.mjs scripts/ui-release-registration.test.mjs scripts/acceptance/lib/live/dsh-process.test.mjs scripts/acceptance/lib/live/live-cli-wire.test.mjs sync/fanout-safety.test.mjs scripts/ui-e2e-preview.test.mjs",
    "test:media": "node --test scripts/acceptance/lib/live/media-decoder.test.mjs scripts/acceptance/lib/live/live-cli-browser.test.mjs",
    "test:desktop-source": "node --import tsx --test scripts/desktop-app.test.mts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-governance": "npm:typescript@5.9.3",
    "yaml-governance": "npm:yaml@2.9.0",
    "vitest": "^5.0.1",
    "yaml": "2.9.0"
  },
  "description": "WorkLoom PMtest · AI 产品经理带领 AI 研发团队，从用户意图到真实产物、验证与交付回执"
}
