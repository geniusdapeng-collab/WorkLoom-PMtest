{
  "name": "@workloom/dsh-pm-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WorkLoom PM mission tools and product branding for the DeepSeek Harness desktop client",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
