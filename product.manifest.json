{
  "schemaVersion": "workloom.product/v1",
  "productId": "workloom-pmtest",
  "role": "industry",
  "displayName": "WorkLoom PMtest",
  "packageName": "workloom-pmtest",
  "repository": "geniusdapeng-collab/WorkLoom-PMtest",
  "defaultBundle": "ai-pm",
  "demoWorkspaceSlug": "ai-pm-demo",
  "demoMemberNo": "MEM-001",
  "release": {
    "appId": "com.workloom.pmtest",
    "channel": "stable",
    "artifactPrefix": "WorkLoom PMtest",
    "workflow": ".github/workflows/desktop-production-release.yml",
    "website": "apps/site"
  },
  "desktop": {
    "portOffset": 231,
    "startPath": "/development"
  },
  "clients": {
    "bPc": { "enabled": true, "entry": "apps/web", "secretaryAutoScan": false },
    "bMobile": { "enabled": true, "entry": "apps/webb" },
    "cMobile": { "enabled": true, "entry": "apps/webc" }
  },
  "clientDelivery": {
    "mode": "repo-owned",
    "note": "独立产品副本的三端应用壳与 packages/ui 随本仓同一提交发布，不接收 WorkLoom IM 的外部客户端基座升级状态。"
  }
}
